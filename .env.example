# Copy to .env.local for local development, and add the same values in Vercel
# (Project → Settings → Environment Variables). Leave them empty to run the demo.

# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). The older "anon" key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your live address, used in sign-up and invitation links, e.g. https://maghr.vercel.app
NEXT_PUBLIC_SITE_URL=

# NEVER add the Supabase "service_role" / secret key here or anywhere in the app.
